# Variables de entorno del backend. Copiar este archivo a ".env" y completar con valores propios.
# NO subir el archivo ".env" a GitHub (ya está ignorado en .gitignore).
#
# Spring Boot NO lee archivos .env por sí solo: hay que cargarlas en la terminal antes de arrancar
#   Linux / Mac:   set -a; source .env; set +a
#   PowerShell:    Get-Content .env | Where-Object { $_ -match '^[^#].*=' } | ForEach-Object { $k,$v = $_ -split '=',2; Set-Item "env:$k" $v }
# o definirlas en la configuración de ejecución del IDE (IntelliJ / VS Code).

# --- Base de datos PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/turnofacil
DB_USERNAME=postgres
DB_PASSWORD=

# --- JWT (OBLIGATORIO: sin JWT_SECRET la aplicación no arranca) ---
# Mínimo 32 caracteres, aleatorio y distinto en cada entorno.
JWT_SECRET=
# Vigencia del token en milisegundos (opcional, por defecto 86400000 = 24 h)
JWT_EXPIRATION=86400000

# --- Primer administrador (opcional) ---
# Si ambas están definidas y el email no existe, se crea un usuario ADMINISTRADOR al arrancar.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Solo para despliegue (opcionales) ---
# Orígenes del frontend permitidos por CORS, separados por coma. Ej: https://turnofacil.vercel.app
CORS_ALLOWED_ORIGINS=
# Puerto HTTP (las plataformas como Render lo definen solas; por defecto 8080)
PORT=8080
