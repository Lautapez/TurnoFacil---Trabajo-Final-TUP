              ],
              "path": [
                "api",
                "professionals",
                "{{profesionalId}}",
                "activate"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Listar todos los turnos (por fecha)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/appointments?fecha={{fecha}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "appointments"
              ],
              "query": [
                {
                  "key": "fecha",
                  "value": "{{fecha}}"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Profesionales y agenda",
      "item": [
        {
          "name": "Listar profesionales activos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/professionals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "professionals"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Listar por especialidad",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/professionals?especialidadId=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "professionals"
              ],
              "query": [
                {
                  "key": "especialidadId",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Listar especialidades",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/specialties",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "specialties"
              ]
            }
          },
          "response": []
