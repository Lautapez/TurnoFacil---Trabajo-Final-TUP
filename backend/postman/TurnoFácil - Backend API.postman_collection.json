{
  "info": {
    "_postman_id": "7d0b72b5-c27b-4abb-a5e4-75e5dfc40e92",
    "name": "TurnoFácil - Backend API",
    "description": "Flujo sugerido: 1) iniciar sesión como ADMIN (variables adminEmail/adminPassword = ADMIN_EMAIL/ADMIN_PASSWORD del backend); 2) crear especialidad; 3) registrar un usuario, asignarle el rol PROFESIONAL y crear su perfil; 4) iniciar sesión como ese profesional y cargar horarios; 5) registrar/iniciar sesión como cliente y reservar. Cada login guarda el token en la variable `token`, que se envía como Bearer en todos los requests (salvo registro y login).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": "admin@turnofacil.com"
    },
    {
      "key": "adminPassword",
      "value": "cambiar-esta-clave"
    },
    {
      "key": "proEmail",
      "value": "profesional@test.com"
    },
    {
      "key": "proPassword",
      "value": "password123"
    },
    {
      "key": "clienteEmail",
      "value": "maria@test.com"
    },
    {
      "key": "clientePassword",
      "value": "password123"
    },
    {
      "key": "admin_id",
      "value": ""
    },
    {
      "key": "pro_id",
      "value": ""
    },
    {
      "key": "cliente_id",
      "value": ""
    },
    {
      "key": "profesionalId",
      "value": "1"
    },
    {
      "key": "turnoId",
      "value": "1"
    },
    {
      "key": "fecha",
      "value": "2026-11-16"
    }
  ],
  "item": [
    {
      "name": "1. Autenticación",
      "item": [
        {
          "name": "Registrar cliente",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"María\",\n  \"apellido\": \"Pérez\",\n  \"email\": \"{{clienteEmail}}\",\n  \"password\": \"{{clientePassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            },
            "description": "El registro público siempre crea un CLIENTE: el body no lleva rol."
          },
          "response": []
        },
        {
          "name": "Registrar usuario (futuro profesional)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Díaz\",\n  \"email\": \"{{proEmail}}\",\n  \"password\": \"{{proPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        },
        {
          "name": "Login ADMINISTRADOR",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('admin', j.token);",
                  "  pm.collectionVariables.set('admin_id', j.id);",
                  "  pm.collectionVariables.set('token', j.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login PROFESIONAL",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{proEmail}}\",\n  \"password\": \"{{proPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('pro', j.token);",
                  "  pm.collectionVariables.set('pro_id', j.id);",
                  "  pm.collectionVariables.set('token', j.token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login CLIENTE",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{clienteEmail}}\",\n  \"password\": \"{{clientePassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('cliente', j.token);",
                  "  pm.collectionVariables.set('cliente_id', j.id);",
                  "  pm.collectionVariables.set('token', j.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
