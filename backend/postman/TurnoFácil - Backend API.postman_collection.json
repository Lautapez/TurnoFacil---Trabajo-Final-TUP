            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuarioId\": \"{{pro_id}}\",\n  \"especialidadId\": 1,\n  \"telefono\": \"2235551234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Listar todos los profesionales",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/professionals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "professionals"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Dar de baja profesional",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/professionals/{{profesionalId}}/deactivate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "professionals",
                "{{profesionalId}}",
                "deactivate"
              ]
            }
          },
          "response": []
