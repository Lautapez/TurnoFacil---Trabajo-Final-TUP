          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/professionals/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "professionals",
                "me"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Ver disponibilidad",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/professionals/{{profesionalId}}/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "professionals",
                "{{profesionalId}}",
                "availability"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Configurar disponibilidad (token PROFESIONAL)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/professionals/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "professionals",
                "availability"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"diaSemana\": 1,\n  \"horaInicio\": \"09:00:00\",\n  \"horaFin\": \"13:00:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "El profesional sale del token; no se envía profesionalId. diaSemana: 1 = lunes ... 7 = domingo."
          },
          "response": []
        }
      ]
    },
    {
      "name": "4. Turnos",
      "item": [
        {
          "name": "Crear turno (token CLIENTE)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"profesionalId\": \"{{profesionalId}}\",\n  \"fecha\": \"{{fecha}}\",\n  \"hora\": \"10:00:00\",\n  \"duracionMinutos\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "El cliente sale del token. La fecha debe caer en un día con franja (RN-01)."
          },
          "response": []
        },
        {
          "name": "Historial del cliente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/user/{{cliente_id}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
