          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{turnoId}}/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "{{turnoId}}",
                "confirm"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Finalizar turno (token PROFESIONAL)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{turnoId}}/finish",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "{{turnoId}}",
                "finish"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Reprogramar turno (token CLIENTE)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{turnoId}}/reschedule",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "appointments",
                "{{turnoId}}",
                "reschedule"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fecha\": \"{{fecha}}\",\n  \"hora\": \"11:00:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Cancelar turno (token CLIENTE)",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/appointments/{{turnoId}}/cancel",
              "host": [
